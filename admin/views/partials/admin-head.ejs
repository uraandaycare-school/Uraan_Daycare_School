<%# admin-head.ejs — shared <head> for all admin pages — Uraan brand design system %>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<title><%= title || 'Admin Panel' %> — Uraan Daycare & School</title>
<link rel="icon" type="image/png" href="/assets/U.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style nonce="<%= nonce %>">
/* ============================================================
   URAAN ADMIN — Brand Design System (matches public site)
   Fonts: Fredoka (titles) + Nunito (body)
   Palette: Navy / Pink / Yellow / Green / Sky Blue
============================================================ */
:root {
  /* Brand palette — identical to public site */
  --navy:         #0F294A;
  --navy-light:   #1A3E6C;
  --navy-dark:    #08172B;
  --pink:         #E91E63;
  --pink-hover:   #D81B60;
  --pink-light:   #FCE4EC;
  --pink-soft:    rgba(233,30,99,0.10);
  --yellow:       #FFB300;
  --yellow-hover: #FFA000;
  --yellow-light: #FFF8E1;
  --yellow-soft:  rgba(255,179,0,0.12);
  --green:        #4CAF50;
  --green-hover:  #43A047;
  --green-light:  #E8F5E9;
  --green-soft:   rgba(76,175,80,0.12);
  --sky:          #E3F2FD;
  --sky-dark:     #BBDEFB;
  --sky-light:    #F4F9FD;
  --blue:         #2196F3;
  --blue-soft:    rgba(33,150,243,0.10);
  --white:        #FFFFFF;
  --gray:         #ECEFF1;
  --muted:        #546E7A;

  /* Surfaces */
  --bg-page:      #E3F2FD;
  --bg-surface:   rgba(255,255,255,0.90);
  --bg-card:      rgba(255,255,255,0.95);
  --glass-border: rgba(255,255,255,0.6);
  --border:       rgba(15,41,74,0.10);
  --border-soft:  rgba(15,41,74,0.06);

  /* Sidebar */
  --sidebar-w:    260px;
  --sidebar-bg:   rgba(255,255,255,0.96);

  /* Typography */
  --font-title:  'Fredoka', 'Quicksand', sans-serif;
  --font-body:   'Nunito', 'Plus Jakarta Sans', sans-serif;

  /* Shadows */
  --shadow-sm:   0 4px 6px rgba(15,41,74,0.06);
  --shadow-md:   0 10px 24px rgba(15,41,74,0.09);
  --shadow-lg:   0 20px 48px rgba(15,41,74,0.13);
  --shadow-pink: 0 8px 24px rgba(233,30,99,0.25);
  --shadow-card: 0 4px 20px rgba(15,41,74,0.07);

  /* Radius */
  --radius-sm:   10px;
  --radius-md:   16px;
  --radius-lg:   24px;
  --radius-full: 50px;

  /* Transitions */
  --ease:        all 0.3s cubic-bezier(0.25,0.8,0.25,1);
  --bounce:      all 0.4s cubic-bezier(0.175,0.885,0.32,1.275);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 15px; scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  background: var(--bg-page);
  color: var(--navy);
  line-height: 1.6;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

h1,h2,h3,h4,h5,h6 { font-family: var(--font-title); color: var(--navy); }
a { text-decoration: none; color: inherit; transition: var(--ease); }

/* ── Layout ── */
.admin-layout { display: flex; min-height: 100vh; }

/* ── Sidebar ── */
.admin-sidebar {
  width: var(--sidebar-w);
  background: var(--sidebar-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0; left: 0;
  height: 100vh;
  overflow-y: auto;
  z-index: 100;
  box-shadow: 4px 0 24px rgba(15,41,74,0.06);
}

.sidebar-logo {
  padding: 22px 20px 18px;
  border-bottom: 1px solid var(--border);
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 8px;
}

.sidebar-brand img {
  width: 38px; height: 38px;
  object-fit: contain;
  transition: var(--bounce);
}

.sidebar-brand:hover img {
  transform: rotate(-6deg) scale(1.1);
}

.brand-text {
  font-family: var(--font-title);
  font-size: 1.4rem;
  font-weight: 700;
  line-height: 1;
}

.brand-text .u  { color: var(--navy-light); }
.brand-text .r  { color: var(--pink); }
.brand-text .a1 { color: var(--yellow); }
.brand-text .a2 { color: var(--blue); }
.brand-text .n  { color: var(--green); }
.brand-sub {
  display: block;
  font-family: var(--font-body);
  font-size: 0.65rem;
  font-weight: 700;
  color: rgba(15,41,74,0.55);
  letter-spacing: 0.02em;
  margin-top: 2px;
}

.sidebar-nav { padding: 12px 12px; flex: 1; }

.nav-section-label {
  font-size: 0.65rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
  padding: 10px 10px 5px;
  margin-top: 4px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  color: rgba(15,41,74,0.70);
  font-size: 0.88rem;
  font-weight: 600;
  font-family: var(--font-body);
  transition: var(--ease);
  margin-bottom: 2px;
}

.nav-link:hover {
  background: var(--sky);
  color: var(--navy);
}

.nav-link.active {
  background: var(--pink-light);
  color: var(--pink);
}

.nav-link.active-yellow {
  background: var(--yellow-light);
  color: var(--yellow-hover);
}

.nav-icon { font-size: 1rem; width: 20px; text-align: center; }

.sidebar-footer {
  padding: 14px 12px;
  border-top: 1px solid var(--border);
}

.admin-chip {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px;
  background: var(--sky);
  border-radius: var(--radius-sm);
  border: 1px solid var(--sky-dark);
  margin-bottom: 8px;
}

.admin-avatar {
  width: 32px; height: 32px;
  background: linear-gradient(135deg, var(--pink), var(--yellow));
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-title);
  font-size: 0.95rem;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.admin-info strong { display: block; font-size: 0.82rem; font-weight: 700; color: var(--navy); }
.admin-info span   { font-size: 0.70rem; color: var(--muted); }

/* ── Main content ── */
.admin-main {
  margin-left: var(--sidebar-w);
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.admin-topbar {
  background: rgba(255,255,255,0.90);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 0 28px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: var(--shadow-sm);
}

.topbar-title {
  font-family: var(--font-title);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--navy);
}

.topbar-breadcrumb {
  font-size: 0.78rem;
  color: var(--muted);
  margin-top: 1px;
}

.admin-content { padding: 28px; flex: 1; max-width: 1400px; }

/* ── Cards ── */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 24px;
  box-shadow: var(--shadow-card);
  transition: var(--ease);
}

.card:hover { box-shadow: var(--shadow-md); }

.card-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20px;
}

.card-title {
  font-family: var(--font-title);
  font-size: 1rem;
  font-weight: 600;
  color: var(--navy);
}

/* ── Stat Cards ── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}

.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  transition: var(--bounce);
  box-shadow: var(--shadow-card);
  border-top: 4px solid transparent;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}

.stat-card.pink-top   { border-top-color: var(--pink); }
.stat-card.yellow-top { border-top-color: var(--yellow); }
.stat-card.green-top  { border-top-color: var(--green); }
.stat-card.blue-top   { border-top-color: var(--blue); }

.stat-icon {
  width: 50px; height: 50px;
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem;
  flex-shrink: 0;
}

.stat-icon.pink   { background: var(--pink-light); }
.stat-icon.yellow { background: var(--yellow-light); }
.stat-icon.green  { background: var(--green-light); }
.stat-icon.blue   { background: #E3F2FD; }

.stat-num {
  font-family: var(--font-title);
  font-size: 2rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 2px;
}

.stat-num.pink   { color: var(--pink); }
.stat-num.yellow { color: var(--yellow-hover); }
.stat-num.green  { color: var(--green); }
.stat-num.blue   { color: var(--blue); }

.stat-label {
  font-size: 0.78rem;
  color: var(--muted);
  font-weight: 600;
}

/* ── Table ── */
.table-wrap { overflow-x: auto; border-radius: var(--radius-sm); }

table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }

thead th {
  background: var(--sky);
  padding: 12px 16px;
  text-align: left;
  font-size: 0.70rem;
  font-family: var(--font-title);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--muted);
  border-bottom: 2px solid var(--sky-dark);
  white-space: nowrap;
}

tbody tr {
  border-bottom: 1px solid var(--border-soft);
  transition: background var(--ease);
}

tbody tr:hover { background: var(--sky-light); }
tbody tr:last-child { border-bottom: none; }
tbody td { padding: 13px 16px; vertical-align: middle; color: var(--navy); }

/* ── Status Badges ── */
.badge {
  display: inline-flex; align-items: center;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  font-family: var(--font-title);
  text-transform: capitalize;
  white-space: nowrap;
}

.badge-active      { background: var(--green-light);  color: var(--green-hover); }
.badge-inactive    { background: var(--yellow-light);  color: var(--yellow-hover); }
.badge-graduated   { background: #E3F2FD;              color: var(--blue); }
.badge-montessori  { background: var(--pink-light);    color: var(--pink); }
.badge-daycare     { background: var(--green-light);   color: var(--green-hover); }
.badge-afterschool { background: var(--yellow-light);  color: var(--yellow-hover); }

/* ── Buttons ── */
.btn {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 9px 20px;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 700;
  font-family: var(--font-title);
  cursor: pointer;
  border: none;
  transition: var(--bounce);
  text-decoration: none;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
}

.btn-primary {
  background: var(--pink);
  color: #fff;
  box-shadow: var(--shadow-pink);
}

.btn-primary:hover {
  background: var(--pink-hover);
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(233,30,99,0.35);
}

.btn-yellow {
  background: var(--yellow);
  color: var(--navy);
  box-shadow: 0 6px 20px rgba(255,179,0,0.3);
}

.btn-yellow:hover {
  background: var(--yellow-hover);
  transform: translateY(-2px);
}

.btn-ghost {
  background: rgba(15,41,74,0.06);
  color: var(--navy);
  border: 1px solid var(--border);
}

.btn-ghost:hover {
  background: var(--sky);
  border-color: var(--sky-dark);
}

.btn-danger-ghost {
  background: transparent;
  color: var(--pink);
  border: 1px solid transparent;
  font-family: var(--font-body);
}

.btn-danger-ghost:hover {
  background: var(--pink-light);
  border-color: rgba(233,30,99,0.2);
}

.btn-sm { padding: 6px 14px; font-size: 0.78rem; }

/* ── Forms ── */
.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 18px;
}

.form-group { display: flex; flex-direction: column; gap: 6px; }
.form-group.full { grid-column: 1 / -1; }

label {
  font-size: 0.72rem;
  font-weight: 800;
  font-family: var(--font-title);
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.07em;
}

input, select, textarea {
  background: var(--white);
  border: 2px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--navy);
  padding: 10px 14px;
  font-size: 0.9rem;
  font-family: var(--font-body);
  width: 100%;
  transition: var(--ease);
  outline: none;
}

input::placeholder { color: var(--muted); opacity: 0.7; }

input:focus, select:focus, textarea:focus {
  border-color: var(--pink);
  box-shadow: 0 0 0 3px var(--pink-soft);
}

select option { background: var(--white); color: var(--navy); }
textarea { resize: vertical; min-height: 90px; }

/* Form section cards */
.form-section { margin-bottom: 20px; }

.form-section-title {
  font-family: var(--font-title);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--pink);
  padding-bottom: 10px;
  border-bottom: 2px solid var(--pink-light);
  margin-bottom: 18px;
  display: flex; align-items: center; gap: 8px;
}

.form-actions {
  display: flex; gap: 12px; align-items: center;
  padding-top: 20px;
  border-top: 2px solid var(--sky-dark);
  margin-top: 4px;
}

/* ── Alerts ── */
.alert {
  padding: 13px 18px;
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  font-weight: 600;
  font-family: var(--font-body);
  margin-bottom: 20px;
  display: flex; align-items: flex-start; gap: 10px;
  border-left: 4px solid transparent;
}

.alert-success {
  background: var(--green-light);
  color: var(--green-hover);
  border-left-color: var(--green);
}

.alert-danger {
  background: var(--pink-light);
  color: var(--pink-hover);
  border-left-color: var(--pink);
}

/* ── Search bar ── */
.search-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
.search-bar input, .search-bar select { flex: 1; min-width: 160px; }

/* ── Pagination ── */
.pagination {
  display: flex; gap: 6px; align-items: center;
  justify-content: center;
  margin-top: 20px;
  padding: 16px;
}

.page-btn {
  padding: 7px 14px;
  border-radius: var(--radius-full);
  background: var(--white);
  border: 1px solid var(--border);
  color: var(--navy);
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 600;
  font-family: var(--font-title);
  transition: var(--bounce);
}

.page-btn:hover {
  background: var(--sky);
  border-color: var(--sky-dark);
  transform: translateY(-1px);
}

.page-btn.active {
  background: var(--pink);
  color: #fff;
  border-color: var(--pink);
  box-shadow: var(--shadow-pink);
}

/* ── Program progress bars ── */
.program-pills { display: flex; flex-direction: column; gap: 12px; }
.program-pill  { display: flex; align-items: center; gap: 10px; }
.pill-label    { font-size: 0.80rem; width: 100px; text-transform: capitalize; font-weight: 600; font-family: var(--font-title); color: var(--navy); }
.pill-bar-wrap { flex: 1; background: var(--sky-dark); border-radius: 20px; height: 8px; overflow: hidden; }
.pill-bar      { height: 100%; border-radius: 20px; transition: width 1s cubic-bezier(0.25,0.8,0.25,1); }
.pill-count    { font-size: 0.78rem; color: var(--muted); width: 24px; text-align: right; font-weight: 700; }

/* ── Status chips ── */
.status-wrap { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
.status-chip {
  flex: 1; min-width: 90px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  text-align: center;
  transition: var(--bounce);
  box-shadow: var(--shadow-sm);
}
.status-chip:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.status-chip .num   { font-family: var(--font-title); font-size: 1.8rem; font-weight: 700; line-height: 1; }
.status-chip .label { font-size: 0.72rem; color: var(--muted); margin-top: 4px; text-transform: capitalize; font-weight: 700; }
.status-chip.active   .num { color: var(--green); }
.status-chip.inactive .num { color: var(--yellow-hover); }
.status-chip.graduated .num { color: var(--blue); }

/* ── Dash grid ── */
.dash-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 24px; }
@media (max-width: 900px) { .dash-grid { grid-template-columns: 1fr; } }

/* ── Utility ── */
.text-muted { color: var(--muted); }
.text-sm    { font-size: 0.82rem; }
.font-title { font-family: var(--font-title); }
.flex       { display: flex; }
.items-center { align-items: center; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.mt-4  { margin-top: 16px; }
.mb-4  { margin-bottom: 16px; }
.justify-between { justify-content: space-between; }

/* ── Scrollbar ── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(--sky); }
::-webkit-scrollbar-thumb { background: var(--sky-dark); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #90CAF9; }

/* ── Responsive ── */
@media (max-width: 768px) {
  .admin-sidebar { transform: translateX(-100%); }
  .admin-main    { margin-left: 0; }
}
</style>
