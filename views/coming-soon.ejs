  <!-- Custom Core Styles -->
  <style>
    body {
      font-family: 'Nunito', sans-serif;
      background-color: #E3F2FD;
      color: #0F294A;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Fredoka', sans-serif;
    }

    /* Vibrant Gradient Brand Text */
    .gradient-text-brand {
      background: linear-gradient(135deg, #E91E63 0%, #FFB300 45%, #4CAF50 85%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .gradient-text-pink {
      background: linear-gradient(135deg, #E91E63 0%, #D81B60 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Custom Glassmorphism Scrollbar */
    ::-webkit-scrollbar {
      width: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #E3F2FD;
    }
    ::-webkit-scrollbar-thumb {
      background: #BBDEFB;
      border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #90CAF9;
    }

    .gpu-accel {
      transform: translate3d(0, 0, 0);
      backface-visibility: hidden;
      perspective: 1000px;
    }

    .floating-shape {
      pointer-events: none;
      position: absolute;
      opacity: 0.28;
    }

    .tour-card {
      opacity: 0.35;
      transform: translateY(30px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .tour-card.active-card {
      opacity: 1;
      transform: translateY(0);
    }

    /* Toast Notification styles */
    .toast-container {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 100;
    }
    .coming-soon-toast {
      background: white;
      border-radius: 20px;
      padding: 16px 28px;
      box-shadow: 0 25px 50px rgba(15, 41, 74, 0.2);
      display: flex;
      align-items: center;
      gap: 14px;
      border: 1px solid rgba(255, 255, 255, 0.8);
      animation: slideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
    @keyframes slideUp {
      from { transform: translateY(40px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    /* Infinite Marquee */
    @keyframes marquee {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(-50%, 0, 0); }
    }
    .animate-marquee {
      display: flex;
      width: max-content;
      animation: marquee 25s linear infinite;
    }
    .animate-marquee:hover {
      animation-play-state: paused;
    }

    /* Floating WhatsApp Button */
    .wa-float {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 90;
      background-color: #25D366;
      color: white;
      width: 60px;
      height: 60px;
      border-radius: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4);
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .wa-float:hover {
      transform: scale(1.1) rotate(6deg);
      box-shadow: 0 15px 30px rgba(37, 211, 102, 0.6);
    }

    /* Slow pulse for glowing background mesh */
    @keyframes pulseGlow {
      0%, 100% { transform: scale(1); opacity: 0.3; }
      50% { transform: scale(1.12); opacity: 0.45; }
    }
    .animate-glow-mesh {
      animation: pulseGlow 8s ease-in-out infinite;
    }
  </style>
</head>
