<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Security Meta -->
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta name="referrer" content="strict-origin-when-cross-origin">

  <!-- SEO Meta Tags -->
  <title>Uraan Daycare &amp; School | Karachi's Premium Montessori &amp; Childcare</title>
  <meta name="description" content="Uraan Daycare &amp; School provides a safe, nurturing, and high-security Montessori early learning and daycare environment in Karachi, Pakistan. Explore our corporate timings and programs today.">
  <meta name="keywords" content="daycare karachi, montessori karachi, school karachi, child care karachi, best playgroup karachi, kids school karachi">
  <meta name="author" content="Uraan Daycare &amp; School">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Social Media -->
  <meta property="og:title" content="Uraan Daycare &amp; School | Montessori &amp; Childcare Karachi">
  <meta property="og:description" content="Nurturing Today, Inspiring Tomorrow. Secure Montessori learning &amp; daycare programs for working parents in Karachi.">
  <meta property="og:image" content="/assets/Uraan.jpeg">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://uraan.edu.pk">

  <!--
    Font Awesome 6.4.0 — loaded via <link> (stylesheet, NOT script).
    SRI hash verified against cdnjs.cloudflare.com registry.
  -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  >

  <!-- Site Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Favicon / Title Bar Mini Logo -->
  <link rel="icon" type="image/png" href="/assets/U.png">

  <!--
    Google reCAPTCHA v2 — nonce injected server-side for CSP compliance.
  -->
  <script
    nonce="<%= nonce %>"
    src="https://www.google.com/recaptcha/api.js"
    async
    defer
  ></script>
</head>
<body>

  <%- include('partials/nav') %>
  <%- include('partials/hero') %>
  <%- include('partials/ticker') %>
  <%- include('partials/about') %>
  <%- include('partials/programs') %>
  <%- include('partials/admissions') %>
  <%- include('partials/contact') %>
  <%- include('partials/footer') %>

  <!--
    Scripts loaded at end of <body> for performance.
    nonce attribute matches per-request CSP header (OWASP A03).
  -->
  <script nonce="<%= nonce %>" src="/js/security.js"></script>
  <script nonce="<%= nonce %>" src="/js/main.js"></script>

</body>
</html>
