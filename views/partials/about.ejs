<%#
  Partial: about.ejs
  Contains: About section, stats, wave dividers, and staff team cards
  Variables used: none (static markup)
  Inline styles removed → CSS utility classes: .img-warm, .award-icon, .delay-015, .delay-03
%>

<!-- ABOUT US SECTION -->
<section id="about" class="section about-section">

  <!-- Wave Divider — Top -->
  <div class="wave-divider wave-top fill-bg-primary">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill-opacity="1" d="M0,160L48,144C96,128,192,96,288,106.7C384,117,480,171,576,192C672,213,768,203,864,181.3C960,160,1056,128,1152,122.7C1248,117,1344,139,1392,149.3L1440,160L1440,0L1392,0C1344,0,1248,0,1152,0C1056,0,960,0,864,0C768,0,672,0,576,0C480,0,384,0,288,0C192,0,96,0,48,0L0,0Z"></path>
    </svg>
  </div>

  <div class="container">

    <!-- Section Header -->
    <div class="section-header text-center animate-on-scroll">
      <span class="badge badge-yellow">Our Identity</span>
      <h2>About <span>Uraan School</span></h2>
      <p>Providing standard child care and foundation-level Montessori education in the heart of Karachi.</p>
    </div>

    <!-- About Content Grid -->
    <div class="about-grid">

      <!-- Text + Stats -->
      <div class="about-content animate-on-scroll">
        <h3>Nurturing Today, Inspiring Tomorrow</h3>
        <p>
          At Uraan Daycare &amp; School, we provide a warm, stimulating environment modeled on
          authentic Montessori principles. Our campus is designed from the ground up to support
          the natural stages of child development — physical, cognitive, social, and emotional.
        </p>
        <p>
          Established in Karachi, Uraan addresses the pressing needs of modern double-income
          corporate families by offering premium school curriculums paired with highly
          supportive daycare structures.
        </p>

        <div class="about-stats">
          <div class="stat-card">
            <div class="stat-number">150+</div>
            <div class="stat-label">Happy Children</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">15+</div>
            <div class="stat-label">Certified Educators</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">100%</div>
            <div class="stat-label">Safety Rating</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">10+</div>
            <div class="stat-label">Montessori Play Areas</div>
          </div>
        </div>
      </div>

      <!-- Image + Badge -->
      <div class="about-image animate-on-scroll delay-02">
        <div class="about-img-container">
          <img
            src="/assets/Uraan.jpeg"
            alt="Founder and teachers teaching young pupils"
            class="img-warm"
          >
        </div>
        <div class="about-img-badge">
          <i class="fas fa-award award-icon"></i>
          <p><strong>Montessori</strong> Certified Educational Frameworks</p>
        </div>
      </div>

    </div>

    <!-- Directoress Section -->
    <h3 class="text-center staff-title animate-on-scroll">Meet Our Directoress</h3>
    <div class="staff-grid max-w-md mx-auto">

      <!-- Directoress Card -->
      <div class="staff-card animate-on-scroll">
        <div class="staff-img-wrapper">
          <img src="/assets/Uraan.jpeg" alt="Montessori Directoress Ms. Nida Asif">
        </div>
        <div class="staff-info">
          <span class="staff-role">Montessori Directoress</span>
          <h4 class="staff-name">Ms. Nida Asif</h4>
          <p class="staff-bio">
            Montessori certified specialist with over 12 years of child development
            experience in leading early childhood institutions across Karachi.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Wave Divider — Bottom -->
  <div class="wave-divider wave-bottom fill-bg-primary">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill-opacity="1" d="M0,64L48,85.3C96,107,192,149,288,149.3C384,149,480,107,576,90.7C672,75,768,85,864,96C960,107,1056,117,1152,112C1248,107,1344,85,1392,74.7L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>
  </div>

</section>
