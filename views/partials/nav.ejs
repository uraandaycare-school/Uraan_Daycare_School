<%#
  Partial: nav.ejs
  Contains: Floating WhatsApp widget + sticky navigation header
  Variables used: none (static markup)
%>

<!-- Floating WhatsApp Contact Widget -->
<button
  id="whatsapp-widget"
  class="floating-whatsapp"
  aria-label="Chat on WhatsApp"
  title="Connect with our Registrar on WhatsApp"
>
  <i class="fab fa-whatsapp"></i>
</button>

<!-- NAVIGATION HEADER -->
<header>
  <div class="container nav-wrapper">

    <a href="#home" class="logo-wrapper" aria-label="Uraan School Home">
      <!-- Brand Logo Image -->
      <img
        src="/assets/U.png"
        alt="Uraan Logo"
        class="logo-img"
      >

      <div class="logo-text">
        <span class="logo-r">r</span><span class="logo-a1">a</span><span class="logo-a2">a</span><span class="logo-n">n</span>
        <span>Daycare</span>
      </div>
    </a>

    <button
      class="burger-menu"
      id="nav-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-links" id="nav-links-list" aria-label="Primary navigation">
      <a href="#home" class="active">Home</a>
      <a href="#about">About Us</a>
      <a href="#programs">Programs</a>
      <a href="#admissions">Admissions</a>
      <a href="#contact">Contact</a>
      <a href="#admissions" class="btn btn-primary ml-10">Apply Now</a>
    </nav>

  </div>
</header>
