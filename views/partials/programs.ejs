<%#
  Partial: programs.ejs
  Contains: Program tabs (Montessori / Daycare) with schedules and timelines
  Variables used: none (static markup)
%>

<!-- PROGRAMS SECTION -->
<section id="programs" class="section programs-section">
  <div class="container">

    <!-- Section Header -->
    <div class="section-header text-center animate-on-scroll">
      <span class="badge badge-pink">What We Offer</span>
      <h2>Curated Learning <span>Programs</span></h2>
      <p>Explore our specialized developmental tiers optimized for different age cohorts and parental timetables.</p>
    </div>

    <!-- Tab Navigation -->
    <div class="tabs-nav animate-on-scroll" role="tablist" aria-label="Program tabs">
      <button
        class="tab-btn active"
        data-tab="tab-montessori"
        role="tab"
        aria-selected="true"
        aria-controls="tab-montessori"
        id="btn-tab-montessori"
      >
        Montessori Early Learning
      </button>
      <button
        class="tab-btn"
        data-tab="tab-daycare"
        role="tab"
        aria-selected="false"
        aria-controls="tab-daycare"
        id="btn-tab-daycare"
      >
        Daycare &amp; After-School Care
      </button>
    </div>

    <!-- ── TAB A: MONTESSORI ─────────────────────────────────────────────── -->
    <div
      id="tab-montessori"
      class="tab-content-panel active"
      role="tabpanel"
      aria-labelledby="btn-tab-montessori"
    >
      <div class="program-details-grid">

        <!-- Description -->
        <div class="program-desc animate-on-scroll">
          <span class="badge badge-pink">Age Group: 2 – 5 Years</span>
          <h3>Foundation For Creative Minds</h3>
          <p>
            Our morning Montessori module is designed to foster a child's natural independence
            and love for inquiry. Through hands-on sensorial activities, language lessons, and
            math exercises, we cultivate self-confidence.
          </p>

          <div class="program-features-list">
            <div class="program-feat-card">
              <i class="fas fa-brain"></i>
              <div>
                <h4 class="program-feat-title">Sensory Development</h4>
                <p class="program-feat-desc">Activities to refine child motor control and senses.</p>
              </div>
            </div>
            <div class="program-feat-card yellow-border">
              <i class="fas fa-abacus"></i>
              <div>
                <h4 class="program-feat-title">Early Arithmetic</h4>
                <p class="program-feat-desc">Concrete math materials enabling deep cognitive growth.</p>
              </div>
            </div>
            <div class="program-feat-card green-border">
              <i class="fas fa-book-open"></i>
              <div>
                <h4 class="program-feat-title">Phonics &amp; Reading</h4>
                <p class="program-feat-desc">Interactive phonetics to inspire fluent readers.</p>
              </div>
            </div>
            <div class="program-feat-card">
              <i class="fas fa-palette"></i>
              <div>
                <h4 class="program-feat-title">Creative Arts</h4>
                <p class="program-feat-desc">Painting, sculpting, and physical expression games.</p>
              </div>
            </div>
          </div>

          <a href="#admissions" class="btn btn-secondary">Apply for Montessori</a>
        </div>

        <!-- Schedule -->
        <div class="program-schedule animate-on-scroll delay-015">
          <div class="schedule-card">
            <div class="schedule-header">
              <h3 class="schedule-title">Montessori Schedule</h3>
              <span class="schedule-time-badge">8:30 AM – 12:30 PM</span>
            </div>
            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-time">08:30 AM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Arrival &amp; Circle Time</h4>
                  <p>Greeting routine, morning prayer, and focus activities.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">09:00 AM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Montessori Work Cycle</h4>
                  <p>Self-directed educational modules with certified equipment.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">11:00 AM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Snack &amp; Hygiene Break</h4>
                  <p>Healthy supervised food layout and hand hygiene lessons.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">11:30 AM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Sensory Play &amp; Outdoor Games</h4>
                  <p>Physical fitness routine in safe organic play pens.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">12:30 PM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Storytelling &amp; Home Departure</h4>
                  <p>Vocabulary building, review, and secure gate release.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ── TAB B: DAYCARE ────────────────────────────────────────────────── -->
    <div
      id="tab-daycare"
      class="tab-content-panel"
      role="tabpanel"
      aria-labelledby="btn-tab-daycare"
    >
      <div class="program-details-grid">

        <!-- Description -->
        <div class="program-desc">
          <span class="badge badge-yellow">Age Group: 3 Months – 10 Years</span>
          <h3>Safe Haven for Growing Kids</h3>
          <p>
            Specifically aligned with Karachi's business hours, our Daycare and After-School
            schedules keep your child safe, engaged, and well-fed. We support infants, toddlers,
            and school-age children under close monitoring.
          </p>

          <div class="program-features-list">
            <div class="program-feat-card green-border">
              <i class="fas fa-utensils"></i>
              <div>
                <h4 class="program-feat-title">Nutritional Meal Plan</h4>
                <p class="program-feat-desc">Cooked balanced lunches and healthy morning/afternoon snacks.</p>
              </div>
            </div>
            <div class="program-feat-card">
              <i class="fas fa-bed"></i>
              <div>
                <h4 class="program-feat-title">Quiet Napping Rooms</h4>
                <p class="program-feat-desc">Cots inside noise-insulated rooms checked by caretakers.</p>
              </div>
            </div>
            <div class="program-feat-card">
              <i class="fas fa-pencil-alt"></i>
              <div>
                <h4 class="program-feat-title">Homework Support</h4>
                <p class="program-feat-desc">Dedicated tutors to supervise after-school assignments.</p>
              </div>
            </div>
            <div class="program-feat-card yellow-border">
              <i class="fas fa-clock"></i>
              <div>
                <h4 class="program-feat-title">Corporate Timings</h4>
                <p class="program-feat-desc">Extended pick-up window option to handle traffic delays.</p>
              </div>
            </div>
          </div>

          <a href="#admissions" class="btn btn-primary">Apply for Daycare</a>
        </div>

        <!-- Schedule -->
        <div class="program-schedule">
          <div class="schedule-card">
            <div class="schedule-header">
              <h3 class="schedule-title">Corporate Care Schedule</h3>
              <span class="schedule-time-badge">8:00 AM – 6:30 PM</span>
            </div>
            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-time">08:00 AM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Check-in &amp; Breakfast</h4>
                  <p>Health check verification at entry, organic breakfast.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">12:30 PM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Nutritious Lunch &amp; Bath</h4>
                  <p>Warm home-style meals and refreshing washing session.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">02:00 PM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Nap Time / Deep Sleep</h4>
                  <p>Insulated dark rooms for cozy rest cycle.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">04:30 PM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Evening Snacks &amp; Tutors</h4>
                  <p>Milk and fruit breaks, homework guides and worksheets.</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-time">06:30 PM</div>
                <div class="timeline-dot"></div>
                <div class="timeline-details">
                  <h4>Safe Pick-up Verification</h4>
                  <p>Release only to biometrically matched verified parents.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
