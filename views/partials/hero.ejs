<%#
  Partial: hero.ejs
  Contains: Hero section with headline, CTA buttons, feature badges, school image
  Variables used: none (static markup)
%>

<!-- HERO SECTION -->
<section id="home" class="hero-section">
  <div class="container hero-grid">

    <!-- Hero Text Content -->
    <div class="hero-content animate-on-scroll">
      <span class="hero-tagline">Nurturing Today, Inspiring Tomorrow</span>
      <h1 class="hero-title">Flying High With <br><mark>Confidence</mark></h1>
      <p class="hero-description">
        Welcome to Uraan Daycare &amp; School in Karachi. We blend authentic Montessori
        learning methodologies with secure, flexible childcare options, ensuring absolute
        peace of mind for corporate working parents.
      </p>

      <div class="hero-buttons">
        <a href="#admissions" class="btn btn-primary">Book a Campus Tour</a>
        <a href="#programs" class="btn btn-outline">Explore Programs</a>
      </div>

      <div class="hero-features">
        <div class="hero-feat-item">
          <span class="hero-feat-icon"><i class="fas fa-shield-alt"></i></span>
          <span>CCTV Hardened</span>
        </div>
        <div class="hero-feat-item">
          <span class="hero-feat-icon"><i class="fas fa-heart"></i></span>
          <span>Pediatric First Aid</span>
        </div>
        <div class="hero-feat-item">
          <span class="hero-feat-icon"><i class="fas fa-user-friends"></i></span>
          <span>Low Teacher Ratio</span>
        </div>
      </div>
    </div>

    <!-- Hero Image -->
    <div class="hero-image-wrapper animate-on-scroll delay-02">
      <div class="blob-bg"></div>
      <div class="hero-image-container">
        <img
          src="/assets/Uraan.jpeg"
          alt="Uraan Daycare &amp; School learning facilities"
          loading="eager"
        >
      </div>
    </div>

  </div>
</section>
